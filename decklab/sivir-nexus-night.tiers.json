{
  "deck": "Sivir — Nexus Night",
  "note": "The worksheet's goal tiers, v2 (§1b, agreed 25 Oct 2026): tier 0 is points from lib/match.mjs; tier 2 is the engine (Power turned into board or answers). Stage 3 resets the targets (the Hidden count target is off until then); the engine tier gains 'units played from face down' when the model plays own-turn flips. Hand-written: change it when the plan changes.",
  "tiers": [
    {
      "tier": 0,
      "goal": "win inside the clock: points every turn",
      "measures": [
        {
          "key": "points.points8",
          "label": "our points by turn 8 (holds, conquers, Evelynn)",
          "dir": "up"
        },
        {
          "key": "points.theirPoints8",
          "label": "their points by turn 8",
          "dir": "down"
        }
      ]
    },
    {
      "tier": 1,
      "goal": "presence: bodies on battlefields, winning fights there (units from face down count)",
      "measures": [
        {
          "key": "shape.cheap",
          "label": "cards at 2 Energy or less",
          "min": 18,
          "max": 22
        },
        {
          "key": "engine.quiet.two2",
          "label": "two units by turn 2",
          "dir": "up"
        },
        {
          "key": "engine.normal.u5",
          "label": "units by turn 5, normal pressure",
          "dir": "up"
        },
        {
          "key": "engine.normal.answered",
          "label": "attacks answered, normal",
          "dir": "up"
        },
        {
          "key": "engine.heavy.answered",
          "label": "attacks answered, heavy",
          "dir": "up"
        },
        {
          "key": "field.bigAns.pop",
          "label": "answer copies per regular 6+ unit",
          "dir": "up"
        }
      ]
    },
    {
      "tier": 2,
      "goal": "the engine: Power turned into board or answers",
      "measures": [
        {
          "key": "engine.normal.merc",
          "label": "Mercenary on (turns 4–8, 2+ Power spent)",
          "dir": "up"
        },
        {
          "key": "engine.normal.fizz",
          "label": "Fizz finds a spell",
          "dir": "up"
        },
        {
          "key": "engine.normal.goldMade",
          "label": "Gold made a game",
          "dir": "up"
        }
      ]
    },
    {
      "tier": 3,
      "goal": "staying power: replace what was spent",
      "measures": [
        {
          "key": "engine.heavy.u5",
          "label": "units by turn 5, heavy pressure",
          "dir": "up"
        },
        {
          "key": "engine.normal.revives",
          "label": "Matriarch revives a game",
          "dir": "up"
        },
        {
          "key": "engine.normal.drawn",
          "label": "extra cards drawn",
          "dir": "up"
        }
      ]
    },
    {
      "tier": 4,
      "goal": "denial, flexible only",
      "measures": [
        {
          "key": "points.stops",
          "label": "their holds stopped a game",
          "dir": "up"
        },
        {
          "key": "field.defyHits.pop",
          "label": "spells Defy would counter (expected)",
          "dir": "down"
        },
        {
          "key": "field.exposed.pop",
          "label": "exposure to Might-limited removal",
          "dir": "down"
        }
      ]
    },
    {
      "tier": 5,
      "goal": "perks: tie-breakers only",
      "measures": [
        {
          "key": "engine.normal.replays",
          "label": "replays a game (Star-Crossed, Dais)",
          "dir": "up"
        }
      ]
    },
    {
      "tier": "always",
      "goal": "a curve and colours that work; Energy is the squeeze",
      "measures": [
        {
          "key": "shape.avg",
          "label": "average cost",
          "min": 2.5,
          "max": 2.75
        },
        {
          "key": "shape.big",
          "label": "cards at 5+ Energy",
          "min": 2,
          "max": 4
        },
        {
          "key": "engine.quiet.stuck3",
          "label": "stuck on colour by turn 3",
          "dir": "down"
        },
        {
          "key": "engine.normal.tricksBlocked",
          "label": "tricks crowded out by Energy",
          "dir": "down"
        }
      ]
    }
  ]
}
