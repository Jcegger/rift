#!/usr/bin/env python3
"""Builds the PDFs listed in guides/remarkable.txt and pushes them to the reMarkable cloud.

    scripts/sync-remarkable             # build, then sync
    scripts/sync-remarkable --dry-run   # build, then show what would be uploaded
    scripts/sync-remarkable --no-build  # sync the PDFs already in guides/out/

Uses rmapi (github.com/ddvk/rmapi) for the cloud: ~/.local/bin/rmapi or rmapi on PATH.
First run asks for a one-time code from https://my.remarkable.com/device/browser/connect;
the token then lives in ~/.config/rmapi. rmapi is a third-party client for reMarkable's
cloud API, not an official tool.

"update" entries are replaced with `put --content-only`, which swaps the PDF but keeps
your highlights and handwriting. "once" entries (sheets you write on) are only uploaded
when missing, never replaced. Nothing on the device is ever deleted.
"""
import os
import pathlib
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "guides" / "out"
MANIFEST = ROOT / "guides" / "remarkable.txt"


def find_rmapi():
    local = pathlib.Path.home() / ".local" / "bin" / "rmapi"
    if local.exists():
        return str(local)
    found = shutil.which("rmapi")
    if not found:
        sys.exit("sync-remarkable: rmapi not found (looked in ~/.local/bin and on PATH)")
    return found


def read_manifest():
    entries = []
    for n, line in enumerate(MANIFEST.read_text().splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) != 3 or parts[1] not in ("update", "once"):
            sys.exit(f"sync-remarkable: {MANIFEST.name}:{n}: expected '<folder> update|once <source>'")
        entries.append(tuple(parts))
    return entries


def pdf_for(source):
    if source.startswith("journal:"):
        return OUT / "journal" / f"{source.split(':', 1)[1]}.pdf"
    return OUT / f"{pathlib.Path(source).stem}.pdf"


def build(entries):
    if any(s.startswith("journal:") for _, _, s in entries):
        subprocess.run([str(ROOT / "scripts" / "build-journal")], check=True, cwd=ROOT,
                       stdout=subprocess.DEVNULL)
    for _, _, source in entries:
        if source.startswith("journal:"):
            continue
        subprocess.run([str(ROOT / "scripts" / "build-guide"), "--pdf", source], check=True,
                       cwd=ROOT, stdout=subprocess.DEVNULL)


def rm(rmapi, *args):
    # No stdin and a timeout: without a saved token rmapi re-prompts for the code forever.
    try:
        return subprocess.run([rmapi, *args], capture_output=True, text=True, cwd=ROOT,
                              stdin=subprocess.DEVNULL, timeout=120)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 1, "", "timed out")


def listing(rmapi, folder):
    """Names in a cloud folder, or None if the folder doesn't exist."""
    r = rm(rmapi, "ls", folder)
    if r.returncode != 0:
        return None
    names = set()
    for line in r.stdout.splitlines():
        if line.startswith("[f]") or line.startswith("[d]"):
            names.add(line[3:].strip())
    return names


def ensure_folder(rmapi, folder, dry):
    path = ""
    for part in [p for p in folder.split("/") if p]:
        parent = path or "/"
        path = f"{path}/{part}"
        existing = listing(rmapi, parent) or set()
        if part not in existing:
            print(f"  mkdir {path}")
            if not dry:
                r = rm(rmapi, "mkdir", path)
                if r.returncode != 0:
                    sys.exit(f"sync-remarkable: mkdir {path} failed: {r.stdout}{r.stderr}")


def main():
    args = set(sys.argv[1:])
    dry = "--dry-run" in args
    entries = read_manifest()
    if "--no-build" not in args:
        print("building PDFs ...")
        build(entries)
    rmapi = find_rmapi()
    if rm(rmapi, "ls", "/").returncode != 0:
        sys.exit("sync-remarkable: rmapi can't reach your account. Run ~/.local/bin/rmapi once "
                 "in a terminal and enter the code from https://my.remarkable.com/device/browser/connect")
    done = {"uploaded": 0, "updated": 0, "kept": 0}
    for folder in sorted({f for f, _, _ in entries}):
        ensure_folder(rmapi, folder, dry)
    for folder, mode, source in entries:
        pdf = pdf_for(source)
        if not pdf.exists():
            sys.exit(f"sync-remarkable: {pdf.relative_to(ROOT)} wasn't built")
        name = pdf.stem
        present = name in (listing(rmapi, folder) or set())
        if present and mode == "once":
            print(f"  keep    {folder}/{name}  (you write on it)")
            done["kept"] += 1
            continue
        flags = ["--content-only"] if present else []
        verb = "update" if present else "upload"
        print(f"  {verb:7} {folder}/{name}")
        if not dry:
            r = rm(rmapi, "put", *flags, str(pdf), folder)
            if r.returncode != 0:
                sys.exit(f"sync-remarkable: put {name} failed: {r.stdout}{r.stderr}")
        done["updated" if present else "uploaded"] += 1
    tail = " (dry run, nothing sent)" if dry else ""
    print(f"done: {done['uploaded']} uploaded, {done['updated']} updated, {done['kept']} kept{tail}")


if __name__ == "__main__":
    main()
