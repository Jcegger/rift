#!/usr/bin/env python3
"""Renders the match journal template (docs/match-journal.md) to PDFs in guides/out/journal/.

    scripts/build-journal             # 5 match pages per night
    scripts/build-journal --pages 8

Writes four files, kept separate on purpose:

    match-night.pdf   blank match pages -- the only one open during games (TR 416.4)
    trouble-list.pdf  the running trouble list -- read between games, never during one
    review.pdf        the ten-match review
    matchup-card.pdf  the deck's matchup table -- between games only, like the trouble list
    questions.pdf     numbered slots for questions to answer later -- never open during a game

Sized 3:4 (6 x 8 in) for a Kindle Scribe; prints fine scaled to A4 or Letter. The pages
carry field labels only -- no shorthand key, no advice -- because anything more is a note
from outside the match. Source of truth is docs/match-journal.md; guides/out/ is build
output (gitignored). The matchup card is the exception: it carries advice, so it is
printed from the matchup table in the current deck's guide (MATCHUPS below) and is never
open during a game. Drawn with matplotlib, so it needs no browser.
"""
import argparse
import pathlib
import re
import textwrap

import matplotlib

matplotlib.use("agg")  # agg measures text widths; PdfPages still writes the PDF
import matplotlib.pyplot as plt
from matplotlib.backends.backend_pdf import PdfPages

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "guides" / "out" / "journal"

W, H = 6.0, 8.0      # page, inches
L, R = 0.35, 5.65    # left and right margins
INK, FAINT = "#000000", "#9a9a9a"


class Page:
    """One page, in inches, y measured down from the top."""

    def __init__(self, pdf):
        self.pdf = pdf
        self.fig = plt.figure(figsize=(W, H))
        self.ax = self.fig.add_axes([0, 0, 1, 1])
        self.ax.set_xlim(0, W)
        self.ax.set_ylim(H, 0)
        self.ax.axis("off")
        self.renderer = self.fig.canvas.get_renderer()

    def text(self, x, y, s, size=7.5, bold=True, ha="left"):
        t = self.ax.text(x, y, s, fontsize=size, fontweight="bold" if bold else "normal",
                         ha=ha, va="baseline", color=INK, family="DejaVu Sans")
        return t.get_window_extent(self.renderer).width / self.fig.dpi

    def line(self, x1, x2, y, lw=0.6, color=INK):
        self.ax.plot([x1, x2], [y, y], color=color, lw=lw, solid_capstyle="butt")

    def vline(self, x, y1, y2, lw=0.6):
        self.ax.plot([x, x], [y1, y2], color=INK, lw=lw, solid_capstyle="butt")

    def fields(self, y, specs, gap=0.12):
        """A row of `label ______` fields; widths are fractions of the row."""
        x, span = L, R - L - gap * (len(specs) - 1)
        for label, frac in specs:
            w = span * frac
            lw = self.text(x, y, label) if label else 0
            self.line(x + lw + 0.04, x + w, y + 0.02)
            x += w + gap

    def box(self, x, y, w, h, lw=0.6):
        self.ax.plot([x, x + w, x + w, x, x], [y, y, y + h, y + h, y], color=INK, lw=lw,
                     solid_capstyle="butt")

    def section(self, y, title):
        self.text(L, y, title.upper(), size=6.5)
        self.line(L, R, y + 0.05, lw=1.2)

    def table(self, y, cols, rows, row_h):
        """cols: [(label, width)]; a width of None takes the rest of the row."""
        fixed = sum(w for _, w in cols if w)
        widths = [w if w else (R - L - fixed) for _, w in cols]
        x = L
        for (label, _), w in zip(cols, widths):
            if label:
                self.text(x + 0.03, y, label, size=6.5)
            x += w
        top = y + 0.07
        bottom = top + row_h * len(rows)
        for i in range(len(rows) + 1):
            self.line(L, R, top + i * row_h)
        x = L
        self.vline(x, top, bottom)
        for w in widths:
            x += w
            self.vline(x, top, bottom)
        for i, cells in enumerate(rows):
            x = L
            for cell, w in zip(cells, widths):
                if cell:
                    self.text(x + w / 2, top + i * row_h + row_h * 0.64, cell, ha="center")
                x += w
        return bottom

    def done(self):
        self.pdf.savefig(self.fig)
        plt.close(self.fig)


def match_page(pdf):
    """One match, as little as possible. The score boxes are the legal record at
    Competitive OPL (TR §415.3: both scores, in writing); the rest is optional."""
    p = Page(pdf)
    p.fields(0.42, [("date", 0.25), ("vs", 0.75)])
    y = 0.95
    bw, bh = 0.46, 0.27            # one box per point: C conquer, H hold, E effect/burn-out
    for g in ("G1", "G2", "G3"):
        p.text(L, y, g, size=9)
        p.text(L + 0.45, y, "1st   2nd", size=8, bold=False)
        y += 0.2
        for who in ("me", "opp"):
            p.text(L, y + bh * 0.7, who, size=7)
            x0 = L + 0.45
            for i in range(10):
                x = x0 + i * bw + (0.12 if i >= 8 else 0)   # 8 to win, then 2 spares
                p.box(x, y, bw, bh, lw=0.6 if i < 8 else 0.35)
                if who == "me":
                    p.text(x + bw / 2, y - 0.03, str(i + 1), size=5, bold=False, ha="center")
            y += bh
        y += 0.36
    p.section(y, "notes")
    y += 0.08
    for _ in range(9):
        y += 0.29
        p.line(L, R, y, lw=0.4, color=FAINT)
    y += 0.5
    p.fields(y, [("next time I'll", 1.0)])
    p.done()


def trouble_page(pdf):
    p = Page(pdf)
    p.text(L, 0.45, "TROUBLE LIST", size=10)
    cols = [("card", 1.1), ("their legend", 0.85), ("marks", 0.6),
            ("what it does to me", None), ("answer", 1.05), ("worked?", 0.5)]
    p.table(0.75, cols, [[""]] * 18, 0.37)
    p.done()


def review_page(pdf):
    p = Page(pdf)
    p.text(L, 0.45, "REVIEW — TEN MATCHES", size=10)
    p.fields(0.78, [("matches", 0.3), ("deck", 0.45), ("lists v", 0.25)])
    p.fields(1.08, [("record: matches", 0.5), ("games", 0.5)])
    bottom = p.table(1.38, [("vs", 1.5), ("match", 0.55), ("games", 0.55), ("why", None)], [[""]] * 6, 0.26)
    y = bottom + 0.32
    p.fields(y, [("game 1", 0.25), ("games 2–3", 0.25), ("going 1st", 0.25), ("going 2nd", 0.25)])
    lines = [
        "mistakes that repeated", "", "by type  t   s   o   c   i   p   r    ·  marks  h   n   f", "“next time I'll” I kept",
        "“next time I'll” I broke", "flags I still can't answer", "",
        "worst matchup → plan", "top trouble card → answer",
        "sideboard cards that earned it", "battlefield to lead with",
        "card I kept wanting", "card that did nothing", "mulligans I'd change",
        "one change to my play", "one question for Jun, or one test",
    ]
    for label in lines:
        y += 0.28
        p.fields(y, [(label, 1.0)])
    p.done()


# The deck being played. Change both lines when the deck changes; the table's first column
# names the opponent and every other column is printed under its own header.
MATCHUPS = ROOT / "guides" / "sivir-trying-her-best.md"
CARD_HEADING = "## 10. Matchups"


def card_rows():
    """The matchup table from the deck's guide, as dicts keyed by its header."""
    src = MATCHUPS.read_text(encoding="utf-8")
    at = src.index(CARD_HEADING)  # fail loudly if the section is renamed
    rows = [ln for ln in src[at:].splitlines() if ln.startswith("|")]
    plain = lambda c: re.sub(r"\*\*|`|\[([^\]]+)\]\([^)]*\)", lambda m: m.group(1) or "", c).strip()
    cells = [[plain(c) for c in r.strip("|").split("|")] for r in rows]
    head, body = cells[0], [r for r in cells[2:] if len(r) == len(cells[0])]
    if len(body) < 5:
        raise SystemExit(f"matchup table has {len(body)} rows; expected the field's main decks")
    return head, [dict(zip(head, r)) for r in body]


def card_pages(pdf):
    """Opponent blocks, flowed down the page and onto the next as needed."""
    head, rows = card_rows()
    wrap = textwrap.TextWrapper(width=80)
    labels = [(k, k) for k in head[1:]]
    p, y = None, 0.0

    def fresh():
        page = Page(pdf)
        page.text(L, 0.45, "MATCHUP CARD — BETWEEN GAMES ONLY", size=10)
        page.text(L, 0.68, f"from {MATCHUPS.relative_to(ROOT)}", size=6, bold=False)
        return page, 0.95

    for row in rows:
        lines = [(lab, wrap.wrap(row[key]) or ["—"]) for lab, key in labels]
        need = 0.2 + 0.15 * sum(len(t) for _, t in lines) + 0.12
        if p is None or y + need > H - 0.35:
            if p:
                p.done()
            p, y = fresh()
        y += 0.2
        p.text(L, y, row[head[0]].split(" (")[0].upper(), size=7)
        for lab, text in lines:
            for i, t in enumerate(text):
                y += 0.15
                if i == 0:
                    p.text(L, y, lab, size=6)
                p.text(L + 0.8, y, t, size=6, bold=False)
        y += 0.06
        p.line(L, R, y, lw=0.4, color=FAINT)
    p.done()


def questions_pages(pdf, pages=10, per_page=6):
    """A notebook for rules questions and "why did I lose that?" moments, written at home
    or between rounds, never during a game (TR §416.4). Slots are numbered across pages so
    an answers sheet can refer to Q7."""
    n = 0
    for _ in range(pages):
        p = Page(pdf)
        p.fields(0.42, [("date", 0.3)])
        p.text(R, 0.42, "QUESTIONS", size=7, ha="right")
        y = 0.75
        for _ in range(per_page):
            n += 1
            y += 0.28
            p.text(L, y, f"Q{n}", size=9)
            p.line(L + 0.45, R, y + 0.02, lw=0.4, color=FAINT)
            for _ in range(2):
                y += 0.3
                p.line(L, R, y + 0.02, lw=0.4, color=FAINT)
            y += 0.28
        assert y < H - 0.25, f"questions page overruns: {y:.2f} in"
        p.done()


def build(name, draw, count):
    with PdfPages(OUT / name) as pdf:
        for _ in range(count):
            draw(pdf)
    print(f"built guides/out/journal/{name}")


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--pages", type=int, default=5, help="match pages in match-night.pdf")
    args = ap.parse_args()
    OUT.mkdir(parents=True, exist_ok=True)
    build("match-night.pdf", match_page, args.pages)
    build("trouble-list.pdf", trouble_page, 3)
    build("review.pdf", review_page, 3)
    build("matchup-card.pdf", card_pages, 1)
    build("questions.pdf", questions_pages, 1)


if __name__ == "__main__":
    main()
