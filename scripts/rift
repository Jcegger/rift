#!/bin/sh
# Launcher for the command-line collection tools. This box has no `node` on PATH,
# so fall back to the Node runtime Playwright bundles.
#
#   scripts/rift                 # collection + deck summary
#   scripts/rift deck sivir      # one deck (main + sideboard) vs. the collection
#   scripts/rift card body rune  # catalog lookup with owned/want/trade
#   scripts/rift want | trade | sets | raw
#   scripts/rift piltover > collection-piltover.csv   # full Piltover import (Replace mode)
#   scripts/rift meta [legend] [--since DATE]          # what the legal field plays (no banned lists)
#   scripts/rift ideas [legend]                        # Radiance-era consensus per legend, vs your deck
#   scripts/rift brew <legend>                         # a winning list changed on purpose (or the crowd's)
#   scripts/rift tune <your deck>                      # reasoned swaps for one of your decks (read only)
#   scripts/rift rising [legend]                       # cards each legend's lists are taking up; the swap scoreboard
#   scripts/rift poll [legend]                         # the preseason model: every build ranked, and why
#   scripts/rift field [--tiers | <legend> | --for <legend>]  # what you will face: experts, record, play
#   scripts/rift event <locator id>                    # a store event: standings + legends
#   scripts/rift intake [champion]                     # after scanning new cards: what landed, where to file it
#
# See scripts/state.mjs for the full command list and data sources.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

NODE=$(command -v node 2>/dev/null)
[ -z "$NODE" ] && NODE=$(ls "$HOME"/anaconda3/lib/python*/site-packages/playwright/driver/node 2>/dev/null | head -1)
[ -z "$NODE" ] && { echo "rift: no node runtime found (looked on PATH and in Playwright's driver)" >&2; exit 127; }

exec "$NODE" "$DIR/state.mjs" "$@"
