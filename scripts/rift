#!/bin/sh
# Launcher for the command-line collection tools. This box has no `node` on PATH,
# so fall back to the Node runtime Playwright bundles.
#
#   scripts/rift                 # collection + deck summary
#   scripts/rift deck sivir      # one deck (main + sideboard) vs. the collection
#   scripts/rift card body rune  # catalog lookup with owned/want/trade
#   scripts/rift want | trade | sets | raw
#   scripts/rift meta [legend] [--since DATE]          # what the legal field plays (no banned lists)
#   scripts/rift bans ["Card" …] [--since DATE]        # what a ban takes: your decks, then every archetype
#   scripts/rift ideas [legend]                        # net decks per legend (or the crowd's list), vs your deck
#   scripts/rift rising [legend]                       # cards each legend's posted lists are taking up
#   scripts/rift poll [legend]                         # the preseason model: every build ranked, and why
#   scripts/rift field [--tiers | <legend> | --for <legend>]  # what you will face: experts, record, play
#   scripts/rift event <locator id>                    # a store event: standings + legends
#   scripts/rift versus <legend> --deck "<name>"       # head to head, card by card, vs that legend's lists
#   scripts/rift try --deck "<name>" "-Card" "+Card"   # test one change: rules, shape, goldfish, field
#   scripts/rift search --deck "<name>" --cands decklab/<f>.json   # many swaps on the same model games, ranked with intervals [--hold-up 0.5]
#   scripts/rift pool <legend> [--job removal]        # a legend's legal cards by job, with their evidence: candidates, not picks
#   scripts/rift identity --deck "<name>" [--id decklab/<brew>.md] [--anchor net]   # the pre-flight as code, jobs vs targets
#   … --file decklab/<draft>.deck.txt                 # in place of --deck on try, search, versus, loops, lifts, identity: a draft in paste text
#   scripts/rift loops --deck "<name>" [--bridges]     # interactions and loops, read from card text
#   scripts/rift fight --attack "<units>" --defend "<units>" [--down …] [--their …]   # one combat, best play both sides ("Unit + Gear"; ";" between names with commas)
#   scripts/rift intake [champion]                     # after adding cards on Piltover: what landed, where to file it
#   scripts/rift kobo                                  # the Kobo's Nexus Night sheets: published, on the server, on the device
#   scripts/rift journal [deck]                        # the app's journal, plus games read off the reMarkable's match sheets
#
# See scripts/state.mjs for the full command list and data sources.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

NODE=$(command -v node 2>/dev/null)
[ -z "$NODE" ] && NODE=$(ls "$HOME"/anaconda3/lib/python*/site-packages/playwright/driver/node 2>/dev/null | head -1)
[ -z "$NODE" ] && { echo "rift: no node runtime found (looked on PATH and in Playwright's driver)" >&2; exit 127; }

exec "$NODE" "$DIR/state.mjs" "$@"
