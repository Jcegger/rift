#!/usr/bin/env python3
"""Pulls the sheets Jay writes on back from the reMarkable, handwriting included.

    scripts/pull-remarkable          # save every written-on sheet to notes/sheets/
    scripts/pull-remarkable --list   # just say which sheets have writing, and on which pages

Reads the "once" entries in guides/remarkable.txt (the writable sheets), downloads each
with rmapi's `geta`, and saves the annotated PDF as notes/sheets/<name>.pdf, replacing the
previous copy: git history keeps every version, so a lost tablet or a lapsed cloud copy
loses nothing. A sheet with no writing on it is skipped. Never changes the device.
"""
import glob
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile
import zipfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "guides" / "remarkable.txt"
SHEETS = ROOT / "notes" / "sheets"


def rmapi():
    local = pathlib.Path.home() / ".local" / "bin" / "rmapi"
    found = str(local) if local.exists() else shutil.which("rmapi")
    if not found:
        sys.exit("pull-remarkable: rmapi not found (looked in ~/.local/bin and on PATH)")
    return found


def writable_sheets():
    for line in MANIFEST.read_text().splitlines():
        parts = line.split("#", 1)[0].split()
        if len(parts) == 3 and parts[1] == "once":
            folder, _, source = parts
            name = source.split(":", 1)[1] if ":" in source else pathlib.Path(source).stem
            yield f"{folder.rstrip('/')}/{name}", name


def run(tool, *args, cwd):
    return subprocess.run([tool, *args], cwd=cwd, capture_output=True, text=True,
                          stdin=subprocess.DEVNULL, timeout=300)


def written_pages(archive):
    """1-based page numbers that carry pen strokes, read from the document's .content."""
    with zipfile.ZipFile(archive) as z:
        content = next((n for n in z.namelist() if n.endswith(".content")), None)
        if not content:
            return []
        meta = json.loads(z.read(content))
        strokes = {os.path.basename(n)[:-3] for n in z.namelist() if n.endswith(".rm")}
    pages = (meta.get("cPages") or {}).get("pages") or [{"id": p} for p in (meta.get("pages") or [])]
    return [i + 1 for i, p in enumerate(pages) if p.get("id") in strokes]


def main():
    list_only = "--list" in sys.argv[1:]
    tool = rmapi()
    SHEETS.mkdir(parents=True, exist_ok=True)
    saved = 0
    with tempfile.TemporaryDirectory() as tmp:
        for path, name in writable_sheets():
            # A plain `get` first: it works on any document, while `geta` errors on one the
            # tablet hasn't opened yet (no page records). Only run geta when there's writing.
            r = run(tool, "get", path, cwd=tmp)
            archive = next(iter(glob.glob(f"{tmp}/{name}.rmdoc") + glob.glob(f"{tmp}/{name}.zip")), None)
            if r.returncode != 0 or not archive:
                print(f"  could not pull {path}: {(r.stdout + r.stderr).strip()[-200:]}")
                continue
            pages = written_pages(archive)
            os.remove(archive)
            if not pages:
                print(f"  blank   {path}")
                continue
            print(f"  written {path}  (pages {', '.join(map(str, pages))})")
            if list_only:
                continue
            r = run(tool, "geta", path, cwd=tmp)
            pdf = pathlib.Path(tmp) / f"{name}-annotations.pdf"
            if r.returncode != 0 or not pdf.exists():
                print(f"    could not render {path}: {(r.stdout + r.stderr).strip()[-200:]}")
                continue
            shutil.copyfile(pdf, SHEETS / f"{name}.pdf")
            saved += 1
    if not list_only:
        print(f"saved {saved} sheet(s) to {SHEETS.relative_to(ROOT)}/")


if __name__ == "__main__":
    main()
